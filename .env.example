# No Cloudflare Pages, cadastre estas variáveis em Settings > Environment variables
# SUPABASE_URL: Supabase > Project Settings > API
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# Chave publishable (sb_publishable_...) ou anon legada. Nunca use service_role!
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICAVEL
