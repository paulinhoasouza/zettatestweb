# Não é obrigatório: o projeto Supabase da v2 já está em src/config.js.
# Use estas variáveis (Cloudflare → Settings → Variables) só para apontar para OUTRO projeto.
# Chave PÚBLICA (sb_publishable_...). Nunca use service_role ou sb_secret_...
# VITE_ZP_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# VITE_ZP_SUPABASE_KEY=sb_publishable_...
# Opcional: publicar um site só de demonstração
# VITE_MODO_DEMO=true
