{
  // Publicação no Cloudflare Workers (Workers Builds): build com `npm run build`,
  // deploy com `npx wrangler deploy`. O nome precisa ser o do Worker no painel.
  "name": "zettatestweb",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
